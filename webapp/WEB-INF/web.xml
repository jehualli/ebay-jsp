<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE web-app
    PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">

<!--
  Servlet 2.3 descriptor. The DTD fixes the element order, and declaring 2.3
  also fixes the JSP dialect: Jasper compiles the pages as JSP 1.2, which
  means scriptlets and custom tags work and ${...} expression language is
  switched off, because EL did not exist until JSP 2.0 in 2003.
-->
<web-app>

  <display-name>eBay</display-name>
  <description>
    A 1999-era auction site built as a Model 2 web application: servlet
    controllers, JavaBean model, JSP 1.2 views and a custom tag library.
  </description>

  <context-param>
    <param-name>siteName</param-name>
    <param-value>eBay - The World's Online Marketplace</param-value>
  </context-param>

  <filter>
    <filter-name>SignIn</filter-name>
    <filter-class>mx.jehualli.ebay.web.filter.SignInFilter</filter-class>
  </filter>

  <!-- Bidding, selling, watching and My eBay need a member. Browsing does not. -->
  <filter-mapping>
    <filter-name>SignIn</filter-name>
    <url-pattern>/bid</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>SignIn</filter-name>
    <url-pattern>/sell</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>SignIn</filter-name>
    <url-pattern>/myebay</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>SignIn</filter-name>
    <url-pattern>/watch</url-pattern>
  </filter-mapping>

  <listener>
    <listener-class>mx.jehualli.ebay.web.Boot</listener-class>
  </listener>

  <servlet>
    <servlet-name>home</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.HomeController</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>browse</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.BrowseController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>item</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.ItemController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>bid</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.BidController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>sell</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.SellController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>myebay</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.MyEbayController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>watch</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.WatchController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>feedback</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.FeedbackController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.LoginController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>logout</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.LogoutController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>help</servlet-name>
    <servlet-class>mx.jehualli.ebay.web.HelpController</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>home</servlet-name>
    <url-pattern>/home</url-pattern>
  </servlet-mapping>
  <!-- Browse and Search are the same controller behind two front doors. -->
  <servlet-mapping>
    <servlet-name>browse</servlet-name>
    <url-pattern>/browse</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>browse</servlet-name>
    <url-pattern>/search</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>item</servlet-name>
    <url-pattern>/item</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>bid</servlet-name>
    <url-pattern>/bid</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>sell</servlet-name>
    <url-pattern>/sell</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>myebay</servlet-name>
    <url-pattern>/myebay</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>watch</servlet-name>
    <url-pattern>/watch</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>feedback</servlet-name>
    <url-pattern>/feedback</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>logout</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>help</servlet-name>
    <url-pattern>/help</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>

  <!-- The taglib element comes last: the 2.3 DTD fixes this order. -->
  <taglib>
    <taglib-uri>http://ebay.example.com/taglib</taglib-uri>
    <taglib-location>/WEB-INF/ebay.tld</taglib-location>
  </taglib>

</web-app>
